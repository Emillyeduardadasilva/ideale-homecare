# Produção na HostGator (hospedagem compartilhada com cPanel).
# Copie para .env no servidor e troque tudo que está entre < >. Guia: docs/HOSTGATOR.md
APP_NAME="Ideale Home Care"
APP_ENV=production
# Gere no seu computador com: php artisan key:generate --show
APP_KEY=<cole-aqui-a-chave-base64>
APP_DEBUG=false
APP_URL=https://<app.seudominio.com.br>
FRONTEND_URL=https://<app.seudominio.com.br>
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# cPanel > Bancos de dados MySQL. Nome e usuário levam o prefixo da sua conta (ex.: conta_ideale).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<conta_ideale>
DB_USERNAME=<conta_ideale>
DB_PASSWORD=<senha-do-banco>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=<app.seudominio.com.br>
CACHE_STORE=database

# Sem worker permanente: o cron do agendador processa a fila a cada minuto.
QUEUE_CONNECTION=database
QUEUE_VIA_SCHEDULER=true

# Tempo real (Reverb) não roda em hospedagem compartilhada; os avisos continuam na central de notificações.
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# cPanel > Contas de e-mail. Crie, por exemplo, nao-responda@seudominio.com.br
MAIL_MAILER=smtp
MAIL_HOST=mail.<seudominio.com.br>
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=<nao-responda@seudominio.com.br>
MAIL_PASSWORD=<senha-do-email>
MAIL_FROM_ADDRESS="<nao-responda@seudominio.com.br>"
MAIL_FROM_NAME="Ideale Home Care"

# Opcional: avisos no navegador. Gere com php artisan care:vapid no seu computador.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
