APP_NAME="Ideale Home Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Domínio HTTPS desta publicação.
APP_URL=https://lumajoias.com.br
FRONTEND_URL="${APP_URL}"
CORS_ALLOWED_ORIGINS="${APP_URL}"
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=USUARIO_ideale
DB_USERNAME=USUARIO_ideale
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
# No plano M, a caixa de notificações usa o banco e o cron de 15 minutos.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=servidor-smtp.example
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contato@seu-dominio.example
MAIL_FROM_NAME="${APP_NAME}"
VAPID_SUBJECT=mailto:contato@seu-dominio.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
